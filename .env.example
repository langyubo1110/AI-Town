# ===== 应用 =====
APP_NAME=AI Town
APP_VERSION=0.1.0
ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
# 业务时区：容器默认 UTC，不指定会让"日程时间"和"现在"差 8 小时
APP_TIMEZONE=Asia/Shanghai
# 前端开发服务器地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== LLM（OpenAI 兼容协议）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ===== 存储 =====
POSTGRES_DSN=postgresql+asyncpg://aitown:aitown@localhost:5432/aitown
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=5
DB_ECHO=false

# ===== Embedding =====
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3
# 必须与数据库里 memories.embedding 的维度一致
EMBED_DIM=1024

# ===== NPC 自主行为 =====
NPC_TICK_ENABLED=true
NPC_TICK_SECONDS=60
NPC_TICK_MAX_BACKLOG=20

# ===== 可观测（Langfuse，可留空关闭）=====
# 云服务：https://cloud.langfuse.com 注册后创建项目拿 key
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# ===== 身份令牌签名密钥 =====
# 玩家身份存在 HttpOnly Cookie 里，值 = "{player_id}.{HMAC-SHA256}"。
# 生产必须换成随机串（默认值是公开的，等于没签名）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=dev-only-change-me

# ===== worker 并发 =====
# 一条对话要 3~5 秒，串行处理时吞吐就是 1/4 秒。
# 4 是实测比较稳的值：再高会把数据库连接池和 LLM 配额打满。
WORKER_CONCURRENCY=4
